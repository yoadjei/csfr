# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/

# checkpoints and large intermediate arrays (regenerate from patches + config)
*.pt
*.npy
*.npz
*.bin
# but keep every input corpus, cluster label, and manifest under data/
!data/*.npy
# small frozen digit CNN for the downstream utility experiment (Task 1a)
!results/downstream/classifier.pt
# SVHN / MNIST raw downloads — re-fetch via src/downstream.py; do not commit
data/svhn/*.mat
data/svhn/*.part
data/mnist/*.gz
data/mnist/*.ubyte

# Logs & temp
logs/
tmp_smoke/
*.log

# Environment
.env
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# LaTeX aux
*.aux
*.bbl
*.blg
*.spl
*.out
*.fls
*.fdb_latexmk
*.synctex.gz

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Internal review material — never publish
*.docx
REVIEW_AND_ACTION_PLAN.md
_comments_extract.md
COMMIT_PLAN.md

# debug scratch renders (not part of the manuscript)
paper/_chk*.png

# internal planning notes (not part of the reproducibility package)
tasks/

# junk from a broken git dir, and an internal status note
.git_broken_*/
IMPLEMENTATION_STATUS_LAMA.md
# matched-compute sweep: config is released, results were never completed
results/csfr_sweep_2d_t2400/

# transfer archives from the gpu runs (results themselves are committed lean)
*.tar.gz
# submission-named pdf copies; scripts/verify.sh regenerates them from the build
paper/CSFR_manuscript.pdf
paper/CSFR_supplementary.pdf

# staged submission package: every file in it is rebuilt from the repository,
# and the cover letter names the authors
submission/
/submission.zip

# ieee access class and its bundled commercial fonts, downloaded from the
# journal's author page. scripts/build_ieee.py falls back to ieeetran when
# absent, so the gate stays green without them.
paper/ieeeaccess/
paper/paper2_ieeeaccess.tex
paper/paper2_ieeeaccess.pdf
paper/paper2_ieeeaccess.docx
paper/.docx_build/
